## ============================================================
## SEGURIDAD INDUSTRIAL - CONFIGURACIÓN DE VARIABLES DE ENTORNO
## ============================================================

## AMBIENTE
# production, development
NODE_ENV=development

## ============================================================
## CLOUDINARY - MANEJO DE IMÁGENES
## ============================================================

VITE_CLOUDINARY_CLOUD_NAME=demo
# Obtén tu cloud name en: https://cloudinary.com/console

## ============================================================
## WEB3FORMS - FORMULARIOS DE CONTACTO
## ============================================================

VITE_WEB3FORMS=your_web3forms_access_key_here
# Obtén tu key en: https://web3forms.com

## ============================================================
## GOOGLE ANALYTICS (Opcional)
## ============================================================

VITE_GA_MEASUREMENT_ID=
# Obtén tu ID en: https://analytics.google.com
